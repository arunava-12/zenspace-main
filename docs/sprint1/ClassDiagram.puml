@startuml
title Sprint 1 - Class Diagram (Prisma Aligned)

' ===== ENUMS =====
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

' ===== MODELS =====
class User {
  id: String
  name: String
  email: String
  password: String
  createdAt: DateTime
}

class Workspace {
  id: String
  name: String
  ownerId: String
  createdAt: DateTime
}

class Project {
  id: String
  name: String
  description: String
  workspaceId: String
  leadId: String
  createdAt: DateTime
}

class Task {
  id: String
  title: String
  description: String
  status: TaskStatus
  priority: Priority
  dueDate: DateTime
  projectId: String
  assigneeId: String
  createdAt: DateTime
}

' ===== RELATIONS (Prisma accurate) =====
User "1" --> "many" Workspace : owns (ownerId)
Workspace "1" --> "many" Project : contains
Project "1" --> "many" Task : contains

User "1" --> "many" Task : assignedTo (assigneeId)
User "1" --> "many" Project : leads (leadId)

@enduml